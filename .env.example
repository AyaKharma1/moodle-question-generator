# Copy to .env and adjust. docker-compose reads this file automatically.
# NEVER commit a real .env with secrets.

# --- Security ---
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ENVIRONMENT=development

# --- AI provider ---
# "mock" works fully offline with no API key (recommended for development/demo).
# "openai" uses an OpenAI-compatible endpoint (also works with local models).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- Database (used when running the backend outside Docker) ---
# Inside docker-compose this is set automatically to the "db" service.
DATABASE_URL=postgresql+psycopg://moodle:moodle@localhost:5432/moodleqg
