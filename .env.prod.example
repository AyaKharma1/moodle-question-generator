# Copy to ".env" on the server and fill in. Never commit the real file.

# Strong random value (>= 32 characters), e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database password (any long random value)
DB_PASSWORD=

# Port on the server where the site is reachable (http://SERVER:PORT)
HTTP_PORT=8081

# true  = anyone who can open the site may create an account
# false = registration closed (create the accounts first, then set to false)
REGISTRATION_OPEN=true

# Optional AI generator: "mock" works offline without a key
AI_PROVIDER=mock
AI_API_KEY=
